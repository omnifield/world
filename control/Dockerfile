# Образ контроллера — руки юзера, упакованные целиком.
#
# ┌─────────────────────────────────────────────────────────────────────────────────────┐
# │ НА МАШИНУ ЮЗЕРА НЕ СТАВИТСЯ НИЧЕГО, КРОМЕ ДОКЕРА (`TECH` 2, рамочное).               │
# │ Значит всё, чем контроллер работает, лежит ЗДЕСЬ: докер-клиент с compose, ssh, bash   │
# │ и готовый подъём двери `deploy/remote.sh`. Ни `git clone`, ни `apk add` на машине     │
# │ хозяина не случается — он делает одно движение: поднимает этот образ.                 │
# └─────────────────────────────────────────────────────────────────────────────────────┘
#
# Контекст сборки — КОРЕНЬ репозитория, а не `control/`: в образ едет ещё и `deploy/`,
# потому что подъём двери мы зовём готовый, а не переписываем свой (`WORLD2-101`).
# Что из корня попадает в контекст — в `control/Dockerfile.dockerignore` (белый список).

# ── сборка бинаря ────────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS build
WORKDIR /src
# Зависимостей у зоны нет и не заводится — только стандартная библиотека, как и у `core`.
# Поэтому ни `go mod download`, ни кэша модулей здесь нет: качать нечего.
COPY control/ ./control/
WORKDIR /src/control
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/control ./cmd/control

# ── образ ────────────────────────────────────────────────────────────────────
FROM alpine:3.20

# Каждый пакет здесь — не «на всякий случай», а требование названного инструмента:
#   docker-cli          сам контроллер (список ресурсов = контексты докера) и `remote.sh`;
#   docker-cli-compose  `remote.sh` поднимает дверь через `docker compose`;
#   openssh-client      транспорт докера до чужого демона; им же контроллер берёт скоуп;
#   bash                `remote.sh` — bash-скрипт, `sh` его не выполнит;
#   ca-certificates     докеру для реестров, если хозяин однажды возьмёт образ оттуда.
RUN apk add --no-cache docker-cli docker-cli-compose openssh-client bash ca-certificates

COPY --from=build /out/control /usr/local/bin/control
# Подъём двери едет ЦЕЛИКОМ и без правок — вместе с файлом запуска, из которого он берёт
# имя образа. Копия здесь — это поставка (`WORLD2` 1.5), а не форк: правит его владелец
# зоны `deploy`, и приезжает она с новой сборкой образа.
COPY deploy/remote.sh /opt/world/deploy/remote.sh
COPY deploy/compose.yaml /opt/world/deploy/compose.yaml

# ── лицо для человека ────────────────────────────────────────────────────────
# Собранный пульт — КАК ЕСТЬ, из результата первого шага сборки. Исходников зоны `web`
# здесь нет по построению: копируется каталог сборки, а не зона.
#
# Пульт СОБИРАЕТСЯ НЕ ЗДЕСЬ, и это не лень. Пакеты пульта лежат на складе локации
# `probe-web`, видном только соседям по сети `omnifield-gateway`, а произвольной сети
# внутри `docker build` buildkit не даёт — сосед на этом уже обжёгся (`deploy/Dockerfile`,
# `tasker:WORLD-37`). Поэтому пульт собирается ДО этого шага, обычным контейнером в сети,
# и сюда приезжает готовым. Ноды в образе контроллера нет вовсе — ни в одном слое.
COPY deploy/.build/web-dist/ /opt/world/pult/

# Пустой каталог COPY проглотит молча, и образ уехал бы с лицом, которого нет. Ловим
# ЗДЕСЬ, а не на первом запросе снаружи: контроллер в этом случае поднимется и честно
# ответит `no-pult` — но образ уже разошёлся, а человек уже открыл адрес.
RUN test -s /opt/world/pult/index.html || { \
        echo "СБОРКА ОСТАНОВЛЕНА: в deploy/.build/web-dist нет собранного пульта."; \
        echo "выход: собери его первым шагом — ./deploy/build.sh --only-web"; \
        exit 1; \
    }

ENV CONTROL_ADDR=":8090" \
    CONTROL_REMOTE_SH="/opt/world/deploy/remote.sh" \
    CONTROL_KEYS="/root/.ssh" \
    CONTROL_PULT="/opt/world/pult" \
    CONTROL_DOCKER="docker"

# Связка ключей и контексты докера — это СОСТОЯНИЕ контроллера, и оба лежат в томах
# (`control/compose.yaml`). Каталоги заводятся здесь с правами, которые примет ssh: ключ в
# каталоге, открытом всем, ssh молча не возьмёт и скажет про формат.
RUN mkdir -p /root/.ssh /root/.docker /scope && chmod 700 /root/.ssh

EXPOSE 8090
ENTRYPOINT ["control"]

# Образ контроллера — руки юзера, упакованные целиком.
#
# ┌─────────────────────────────────────────────────────────────────────────────────────┐
# │ НА МАШИНУ ЮЗЕРА НЕ СТАВИТСЯ НИЧЕГО, КРОМЕ ДОКЕРА (`TECH` 2, рамочное).               │
# │ Значит всё, чем контроллер работает, лежит ЗДЕСЬ: докер-клиент с compose, ssh, bash   │
# │ и готовый подъём двери `deploy/remote.sh`. Ни `git clone`, ни `apk add` на машине     │
# │ хозяина не случается — он делает одно движение: поднимает этот образ.                 │
# └─────────────────────────────────────────────────────────────────────────────────────┘
#
# Контекст сборки — КОРЕНЬ репозитория, а не `control/`: в образ едет ещё и `deploy/`,
# потому что подъём двери мы зовём готовый, а не переписываем свой (`WORLD2-101`).
# Что из корня попадает в контекст — в `control/Dockerfile.dockerignore` (белый список).

# ── сборка бинаря ────────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS build
WORKDIR /src
# ЗАВИСИМОСТЬ У ЗОНЫ ОДНА И ЗАВЕДЕНА ОСОЗНАННО: `golang.org/x/crypto/ssh` (решение user,
# `WORLD2-141`). Ею контроллер один раз заходит на машину ПАРОЛЕМ, чтобы завести там ключ:
# системный ssh пароля не берёт, а подменять его обёрткой или писать свой транспорт —
# запрещено. Раньше зона жила на одной стандартной библиотеке, и это стоит помнить: каждая
# следующая зависимость — решение architect, а не привычка.
#
# Отсюда и шаг ниже: модули тянутся ОТДЕЛЬНЫМ слоем, до исходников. Так пересборка после
# правки кода не ходит в сеть заново.
COPY control/go.mod control/go.sum ./control/
WORKDIR /src/control
RUN go mod download
COPY control/ /src/control/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/control ./cmd/control

# ── образ ────────────────────────────────────────────────────────────────────
FROM alpine:3.20

# Каждый пакет здесь — не «на всякий случай», а требование названного инструмента:
#   docker-cli          сам контроллер (список ресурсов = контексты докера) и `remote.sh`;
#   docker-cli-compose  `remote.sh` поднимает дверь через `docker compose`;
#   openssh-client      транспорт докера до чужого демона; им же контроллер берёт скоуп;
#   bash                `remote.sh` — bash-скрипт, `sh` его не выполнит;
#   ca-certificates     докеру для реестров, если хозяин однажды возьмёт образ оттуда.
RUN apk add --no-cache docker-cli docker-cli-compose openssh-client bash ca-certificates

COPY --from=build /out/control /usr/local/bin/control
# Подъём двери едет ЦЕЛИКОМ и без правок — вместе с файлом запуска, из которого он берёт
# имя образа. Копия здесь — это поставка (`WORLD2` 1.5), а не форк: правит его владелец
# зоны `deploy`, и приезжает она с новой сборкой образа.
COPY deploy/remote.sh /opt/world/deploy/remote.sh
COPY deploy/compose.yaml /opt/world/deploy/compose.yaml

# РЕЦЕПТ РАЗДАЧИ СКОУПА — тем же порядком и по той же причине. Завести скоуп значит поднять
# раздачу на машине, которую назвал юзер (`WORLD2` 3.4), а поднимается она рецептом, как
# любая вещь мира. Рецепт — файл зоны `share`, и приезжает он КОПИЕЙ (`WORLD2` 1.5): правит
# его владелец той зоны, к нам он попадает вместе с новой сборкой образа.
#
# Образ самой раздачи здесь НЕ лежит: его везёт на ту машину подъём — копией отсюда либо
# из реестра. Чего именно не хватает, скажет отказ соседа, и он назовёт имя образа сам.
COPY share/compose.yaml /opt/world/share/compose.yaml

# ── каталог рецептов ─────────────────────────────────────────────────────────
# ЧТО ПОДНИМАЕТСЯ НА РЕСУРСЕ — ГОВОРИТ РЕЦЕПТ, А НЕ КОНТРОЛЛЕР (`WORLD2` 3.7, `WORLD2-131`).
# Каталог едет ПУСТЫМ, и это не забывчивость: перечня вещей у мира нет, а дверь лежит рядом
# с подъёмом и второй копией здесь не появляется — две копии одного файла разъехались бы
# молча. Свои вещи хозяин машины кладёт сюда монтированием:
#
#   docker run … -v ~/мои-рецепты:/opt/world/recipes:ro …
#
# Ради этого каталог и заведён отдельным путём: положить вещь можно БЕЗ пересборки образа и
# без единой правки кода — иначе вещь снова была бы зашита, а не описана.
RUN mkdir -p /opt/world/recipes

# ── лицо для человека ────────────────────────────────────────────────────────
# Собранный пульт — КАК ЕСТЬ, из результата первого шага сборки. Исходников зоны `web`
# здесь нет по построению: копируется каталог сборки, а не зона.
#
# Пульт СОБИРАЕТСЯ НЕ ЗДЕСЬ, и это не лень. Пакеты пульта лежат на складе локации
# `probe-web`, видном только соседям по сети `omnifield-gateway`, а произвольной сети
# внутри `docker build` buildkit не даёт — сосед на этом уже обжёгся (`deploy/Dockerfile`,
# `tasker:WORLD-37`). Поэтому пульт собирается ДО этого шага, обычным контейнером в сети,
# и сюда приезжает готовым. Ноды в образе контроллера нет вовсе — ни в одном слое.
COPY deploy/.build/web-dist/ /opt/world/pult/

# Пустой каталог COPY проглотит молча, и образ уехал бы с лицом, которого нет. Ловим
# ЗДЕСЬ, а не на первом запросе снаружи: контроллер в этом случае поднимется и честно
# ответит `no-pult` — но образ уже разошёлся, а человек уже открыл адрес.
RUN test -s /opt/world/pult/index.html || { \
        echo "СБОРКА ОСТАНОВЛЕНА: в deploy/.build/web-dist нет собранного пульта."; \
        echo "выход: собери его первым шагом — ./deploy/build.sh --only-web"; \
        exit 1; \
    }

ENV CONTROL_ADDR=":8090" \
    CONTROL_REMOTE_SH="/opt/world/deploy/remote.sh" \
    CONTROL_RECIPES="/opt/world/recipes" \
    CONTROL_SHARE_RECIPE="/opt/world/share/compose.yaml" \
    CONTROL_KEYS="/root/.ssh" \
    CONTROL_PULT="/opt/world/pult" \
    CONTROL_DOCKER="docker"

# ── подъём одной командой ────────────────────────────────────────────────────
# ТОЧКА ВХОДА — то, что раньше делал `control/up.sh` снаружи (`WORLD2-120`). Она здесь
# потому, что снаружи на машине юзера нет ничего: ни репозитория, ни скрипта, ни файла
# запуска — только докер. Проверки, которые не уехали в образ, не существуют вовсе.
#
# Отдельным ФАЙЛОМ, а не строкой `RUN cat > … <<EOF`: файл читается, правится и прогоняется
# без докера (`control/probe-control.sh`, раздел «точка входа образа»). Точку входа, которую
# нельзя ни прочитать, ни прогнать, проверяет только живой подъём — то есть юзер.
#
# Стук вынесен третьим файлом, и это не дробление: им пользуются ДВОЕ — точка входа (дождаться
# ответа при подъёме) и HEALTHCHECK ниже. Вторая копия стука разошлась бы с первой молча.
#
# Права берутся из репозитория (в гите оба файла исполняемые) — отдельного `chmod` слоем не
# заводим: он лечил бы следствие, а причина — забытый бит в гите, и она видна на ревью.
COPY control/control-entry.sh /usr/local/bin/control-entry.sh
COPY control/knock.sh /usr/local/bin/control-knock.sh

# Связка ключей и контексты докера — ВРЕМЯНКИ контроллера (`WORLD2` 1.9): они раскладываются
# из скоупа при входе и снимаются при выходе. Каталоги заводятся здесь с правами, которые
# примет ssh: ключ в каталоге, открытом всем, ssh молча не возьмёт и скажет про формат.
#
# Каталога под скоупы здесь НЕТ и не будет: личность юзера лежит там, где он её положил, и
# контроллер до неё дотягивается. Пока она лежала здесь, снос контроллера означал потерю
# себя (`WORLD2-124`, найдено живым прогоном).
RUN mkdir -p /root/.ssh /root/.docker && chmod 700 /root/.ssh

EXPOSE 8090

# Проба изнутри — чтобы `docker ps` показывал не «поднят», а «отвечает». ЖИВЁТ ОНА ЗДЕСЬ, а
# не в файле запуска: юзер поднимает контроллер одной командой `docker run`, и здоровье,
# объявленное в `compose.yaml`, до него бы не доехало вовсе (`WORLD2-120`). Компоуз
# наследует объявленное образом — второго объявления там нет намеренно.
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/control-knock.sh"]

# Точка входа — НЕ сам бинарь: она проверяет власть над машиной и состояние, поднимает
# контроллер, дожидается его ответа и говорит, чего не хватает для добавления ресурса.
# Бинарь при этом никуда не спрятан — попроси другую команду (`docker run … bash`), и она
# будет выполнена как есть.
ENTRYPOINT ["/usr/local/bin/control-entry.sh"]

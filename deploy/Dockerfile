# syntax=docker/dockerfile:1
#
# Образ мира — вход в поле, который поднимается ОДНИМ докером.
#
# Зачем именно образ, а не консоль поверх исходников: скоуп не вправе зависеть от того,
# идёт ли в нём стройка и чем её ведут (`kb:WORLD-54`). Образу для подъёма нужен только
# докер; консоли нужна ещё и нода на машине — и мир, которому нужна нода, чтобы открыть
# дверь, снова привязан к чужому инструменту.
#
# ЛИЦА ДЛЯ ЧЕЛОВЕКА В ЭТОМ ОБРАЗЕ НЕТ. Дверь — вход и выход, она ничего не показывает
# (`WORLD2` 5.1 п.4, 3.7): пульт раздаёт КОНТРОЛЛЕР, и собранный пульт лежит в ЕГО образе
# (`control/Dockerfile`). Здесь его нет ни слоем, ни каталогом, ни переменной — иначе он
# ехал бы к потребителю мёртвым грузом, а первый же вопрос «почему в двери лицо старее»
# стал бы вопросом без ответа.
#
# ЭТОТ ФАЙЛ НИЧЕГО НЕ СТРОИТ ИЗ СЕТИ — он складывает готовое. Всё, что здесь осталось из
# «активного», — компиляция Go, у которой зависимостей нет. Отсюда `network: none` у сборки
# в файле запуска: не украшение, а машинное доказательство.
#
# Контекст сборки — КОРЕНЬ репозитория (нужен `core/`), а не `deploy/`. Что из корня
# попадает в контекст, решает `deploy/Dockerfile.dockerignore` — файл рядом с этим, а не
# в корне: правило зоны живёт в зоне.


# ----------------------------------------------------------------- 1. дверь: собираем бинарь
#
# Зависимостей у `core` нет и не заводится — только стандартная библиотека Go, поэтому ни
# `go.sum`, ни `go mod download` здесь не участвуют, и сеть этому слою не нужна.
FROM golang:1.26-alpine AS core

WORKDIR /src/core
COPY core/ ./

# CGO выключен — бинарь статический и не тянет из финального слоя ни libc, ни резолвер.
# `-trimpath` убирает пути сборочной машины: в образ не должно уезжать даже имя каталога,
# в котором его собрали.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/world ./cmd/world


# ------------------------------------------------------------------- 2. мир: тонкий образ
#
# alpine, а не scratch: `scratch` дешевле на пару мегабайт, но в нём нет ни `wget` для
# HEALTHCHECK, ни оболочки, чтобы посмотреть на месте, что случилось. Отказ, который
# некому назвать, дороже двух мегабайт (`kb:WORLD-31`). Ничего сверх базового образа не
# ставится: `wget` — базовый апплет busybox, и он есть всегда.
#
# Именно «есть всегда» здесь и важно. Апплет `httpd` из базового busybox УЕХАЛ в отдельный
# пакет `busybox-extras`, и проба, которая на него опиралась, однажды просто перестала
# подниматься (`tasker:WORLD-37`). Всё, чем мы пользуемся из базового образа, обязано быть
# базовым — а не «было там в прошлый раз».
FROM alpine:3

LABEL org.opencontainers.image.title="omnifield world" \
      org.opencontainers.image.description="Вход в поле: дверь и реестр локаций (лица нет — пульт при контроллере)" \
      org.opencontainers.image.source="https://github.com/omnifield/world"

# Мир бежит не из-под root. Каталоги реестра и прогонов создаются ЗДЕСЬ и с этим
# владельцем не просто так: пустой именованный том докер инициализирует правами того
# каталога, поверх которого его монтируют. Не создать — том приедет root'овым, и процесс
# не сможет записать реестр (`write-failed` на первой же регистрации).
RUN addgroup -S world \
 && adduser -S -G world -H -s /sbin/nologin world \
 && mkdir -p /field /stand \
 && chown -R world:world /field /stand

# В финальный слой уезжают ДВЕ вещи, и обе исполняемые: бинарь мира и точка входа образа.
# Каталога под витрину здесь по-прежнему нет намеренно: пустой `/app/web` в образе двери
# читался бы как «раздача просто выключена», и первый же человек попробовал бы туда
# что-нибудь положить.
COPY --from=core /out/world /app/world

# ТОЧКА ВХОДА — то, что раньше делал `deploy/up.sh` снаружи (`WORLD2-121`). Она здесь
# потому, что снаружи на машине юзера нет ничего: ни репозитория, ни скрипта, ни файла
# запуска — только докер. Проверки, которые не уехали в образ, не существуют вовсе.
#
# Отдельным ФАЙЛОМ, а не строкой `RUN cat > … <<EOF`: файл читается, правится и прогоняется
# без докера (`deploy/probe-branching.sh`, раздел 30). Точка входа, которую нельзя ни
# прочитать, ни прогнать, проверяется только живым подъёмом — то есть на юзере.
#
# Права берутся из репозитория (в гите файл исполняемый) — отдельного `chmod` слоем не
# заводим: он лечил бы следствие, а причина — забытый бит в гите, и она видна на ревью.
COPY deploy/door-entry.sh /app/door-entry.sh

# Переменные названы явно, а не оставлены на умолчания `core`: умолчания там относительные
# (`../field/locations.json`, `../stand`) и верны для запуска из каталога `core/` — в образе
# таких каталогов нет. Контракт переменных — `core/README.md`.
#
# WORLD_ADDR трогать нечего: порт внутри контейнера фиксирован — на него смотрят EXPOSE и
# HEALTHCHECK. Крутится ХОСТ-порт, и крутится он в файле запуска (`WORLD_PORT`).
ENV WORLD_ADDR=":8080" \
    WORLD_DOOR_FILE="/field/locations.json" \
    WORLD_STAND_DIR="/stand"

# Состояние поля и журналы прогонов — на томах, а не в слое контейнера (`kb:WORLD-28`).
# Строка объявляет намерение; ИМЕНОВАННЫМИ тома делает файл запуска: анонимный том
# переживёт пересоздание, но найти его потом нельзя — безымянное не хранилище, а свалка.
VOLUME ["/field", "/stand"]

USER world
WORKDIR /app
EXPOSE 8080

# Проба изнутри — чтобы `docker ps` показывал не «поднят», а «отвечает». Снаружи дверь
# проверяет `deploy/probe.sh`: изнутри контейнера опубликованный порт не проверить.
#
# Тем же `wget`, что стучится в точке входа: два разных стука в одну дверь однажды разошлись
# бы в мелочи, и «здоров по докеру, мёртв по нам» стало бы вопросом без ответа.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

# Точка входа — НЕ сам бинарь: она проверяет состояние, поднимает мир, дожидается ответа
# двери и говорит, видно ли её в поле. Бинарь при этом никуда не спрятан — попроси другую
# команду (`docker run … sh`), и она будет выполнена как есть.
ENTRYPOINT ["/app/door-entry.sh"]

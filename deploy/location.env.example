# Конфиг ЛОКАЦИИ — единственное, что человек заполняет перед подъёмом.
#
#   cp deploy/location.env.example deploy/location.env
#   <открыть и заполнить первые два значения>
#   ./deploy/location-up.sh
#
# Свой `deploy/location.env` в гит не едет (закрыт `deploy/.gitignore`): это настройка
# КОНКРЕТНОЙ локации на конкретной машине, а не схема. В репозитории живёт только этот
# образец.
#
# Значений ровно четыре, и два из них с умолчаниями. Больше в первой редакции не нужно
# ничего: вход в поле — это имя, что даёшь, куда стучаться и в какой сети.
#
# Форма строк — `КЛЮЧ=значение`, по одному в строке. Значение читается до конца строки;
# кавычки, если они стоят, снимаются. Так это понимают и компоуз, и подъём.


# ─────────────────────────────────────────────────────── обязательные

# Имя локации в поле. Оно же — её МАРШРУТ за дверью (`http://<дверь>/<имя>/`) и её же имя
# в общей сети: alias = имя = ключ реестра (`kb:FUND-5`). Три вещи, а слово одно, и это
# правило, а не совпадение — разойдись они однажды, и список за дверью снова станет чьей-то
# памятью (`kb:WORLD-53`).
#
# Алфавит имени держит ДВЕРЬ, а не этот файл: `^[a-z0-9][a-z0-9-]{0,62}$`, и отказ
# `name-invalid` называет правило целиком. Второй копии правила здесь нет намеренно —
# копия разъезжается с оригиналом молча.
WORLD_NAME=

# Что локация даёт — одной строкой, человеку. Обязательна: локация без описания попадёт в
# список за дверью безымянной, и взять её осмысленно будет нельзя.
WORLD_GIVES=


# ─────────────────────────────────────────────────────── с умолчаниями

# Адрес ДВЕРИ в общей сети, «имя:порт» без схемы. Умолчание — контрактное имя двери
# (`deploy/compose.yaml`, настройка `WORLD_DOOR_ALIAS`). Менять здесь приходится тогда,
# когда в поле это имя пришлось освободить.
#WORLD_DOOR=door:8080

# Общая сеть, в которой стоят дверь и соседи. Сеть общая на машину и старше любого
# компоуз-проекта, поэтому подключаемся к существующей, а не создаём свою.
#WORLD_NET=omnifield-gateway

# syntax=docker/dockerfile:1
#
# Образ ЛОКАЦИИ — второе изделие мира (`kb:WORLD-53`).
#
# Мир даёт ровно два образа: образ мира разворачивает контейнер мира (дверь и пульт),
# образ локации — настроенный контейнер локации, который САМ входит в поле. Новой сущности
# при этом не заводится: внутри тот же бинарь `core`, поднятый другим режимом. Один бинарь,
# два режима, два образа.
#
# ПОЧЕМУ ОБРАЗ ОТДЕЛЬНЫЙ, А НЕ `omnifield/world:dev` С ДРУГОЙ КОМАНДОЙ. Бинарь там тот же,
# и соблазн понятен, но образ мира несёт в себе СОБРАННЫЙ ПУЛЬТ, а пульт собирается только
# в живом поле: пакеты `@omnifield/probe-web-*` лежат на складе локации `probe-web` и
# наружу не торчат (`kb:FUND-5`). Значит «локация = образ мира» означало бы: чтобы поднять
# пустую локацию, нужно поле, которое умеет собирать фронт. Локация обязана вставать там,
# где есть один докер, — это и есть `kb:WORLD-54`: скоуп не привязан к стройке.
#
# Отсюда свойство, которого у образа мира нет и быть не может: ЭТОТ образ собирается без
# поля вообще. Ни склада, ни первого шага сборки, ни каталога `deploy/.build/` — только
# `core/` и компилятор Go, у которого зависимостей нет.
#
# ПОЛЕ — не то же, что СЕТЬ, и путать их здесь дорого. Сеть сборке нужна: приезжают базовые
# образы и пакеты ландшафта (ниже). Поле — нет: ни склада `probe-web`, ни двери, ни соседей.
# «Локация встаёт там, где есть один докер» (`kb:WORLD-54`) — про подъём, и оно цело:
# ГОТОВЫЙ образ поднимается вовсе без сети, переносится `docker save … | docker load`.
#
# Контекст сборки — КОРЕНЬ репозитория (нужен `core/`), а что из него попадает в контекст,
# решает `deploy/Dockerfile.location.dockerignore` — файл рядом с этим, а не в корне:
# правило зоны живёт в зоне.


# ------------------------------------------------------- 1. бинарь: тот же, что у мира
# Слово в слово как в `deploy/Dockerfile`, и это не копипаста по недосмотру: собирается
# ОДИН И ТОТ ЖЕ бинарь из одной и той же зоны. Разъедься эти два шага — мир и локация
# начали бы говорить разными версиями одного протокола, а выглядело бы это как сетевая
# неполадка.
FROM golang:1.26-alpine AS core

WORKDIR /src/core
COPY core/ ./

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/world ./cmd/world


# ---------------------------------------------------------- 2. локация: тонкий образ
# alpine, а не scratch, по той же причине, что у мира: нужен `wget` для HEALTHCHECK и
# оболочка, чтобы посмотреть на месте, что случилось. Всё, чем пользуемся, — базовые
# апплеты busybox: на «было там в прошлый раз» мы уже обожглись (`httpd` уехал в
# отдельный пакет, `tasker:WORLD-37`).
FROM alpine:3

LABEL org.opencontainers.image.title="omnifield location" \
      org.opencontainers.image.description="Локация поля: сторож «я здесь» и вход в поле одной командой" \
      org.opencontainers.image.source="https://github.com/omnifield/world"

# Метка для редактора: чем открывать место, знает САМО МЕСТО, а не машина человека.
# Привязка (VS Code → Attach to Running Container) читает `devcontainer.metadata` из образа
# и заходит сразу тем пользователем и в тот каталог, которые здесь названы, — иначе каждый
# настраивает это у себя, и каждый по-своему (живой упор: редактор открывал `/home/world`,
# а работать надо в складе, `tasker:WORLD-108`).
#
# `remoteUser: world` — тот же пользователь, под которым бежит сторож: root здесь не нужен
# и не даётся. `workspaceFolder: /place` — склад под застройку, единственное, что лежит на
# томе: открытый дом означал бы работу во времянке (`WORLD2` 1.9).
LABEL devcontainer.metadata='[{"remoteUser":"world","workspaceFolder":"/place"}]'

# ------------------------------------------------------------------ ЛАНДШАФТ МЕСТА
# То, что есть на месте ИЗНАЧАЛЬНО. Это не инструменты: мир не изготовил `git` и не выдаёт
# его — он задаёт, каким место РОЖДАЕТСЯ (`tasker:WORLD-102`). Пустое место, на котором
# ничего нельзя сделать, бесполезно: застройка приезжает клоном схемы и ставится тем, что
# на месте уже лежит.
#
# РОВНО ЭТИ ЧЕТЫРЕ и не больше — решение user 2026-08-12:
#
#   git              иначе стройка отказывает `git-missing` (`core/README.md`);
#   nodejs + npm     чем сегодня ставится и запускается почти всё, что мы строим;
#   ca-certificates  без них ни одна схема не поедет по https, а отказ выглядел бы как
#                    «схемы нет» — то есть уводил бы чинить не то (`kb:WORLD-31`);
#   curl             чем внутри места достучаться до соседа и до двери.
#
# `pnpm`, `go`, `python` и прочее СЮДА НЕ КЛАДЁМ. Это другая схема локации, и заводится она
# под задачу: базовый ландшафт, растущий «на всякий случай», превращается во «всё сразу», а
# каждое место платит за это размером и временем подъёма.
#
# `openssh-client` тоже нет: он нужен, только если схемы поедут по `ssh://` (`core/README.md`
# называет его условным). Появится такой случай — это отдельное решение, а не запас впрок.
#
# ЧЕМ ЭТО ПЛАТИТСЯ, СКАЗАНО ВСЛУХ: у сборки образа локации ТЕПЕРЬ ЕСТЬ СЕТЬ — пакеты тянутся
# из репозиториев alpine. Поле для этого по-прежнему НЕ нужно (`kb:WORLD-54`): нужен выход
# наружу, а не склад и не дверь. Отсюда снят `network: none` в `deploy/location-compose.yaml`
# — и снят он ровно здесь, а не «на всякий случай»: без сети сборка теперь не поедет вовсе.
RUN apk add --no-cache git nodejs npm ca-certificates curl

# В МЕСТО ОБЯЗАН ВХОДИТЬ ЧЕЛОВЕК. Инструменты без этого бесполезны: юзер строит на месте
# руками, других способов мир не предлагает (`WORLD2` 1.0 — разворачивает юзер). Поэтому у
# пользователя `world` есть ДОМ и живая ОБОЛОЧКА, и это часть ландшафта, а не удобство.
#
# Живой случай 2026-08-13 (`tasker:WORLD-106`): заселение `probe-web` уткнулось трижды —
# редактор не подключился (`mkdir: can't create directory '/home/world/': Permission
# denied`: дом записан в паспорте, а каталога нет и создать его `world` не может), терминал
# не стартовал (`"/sbin/nologin" terminated with exit code: 1`), и каждая правка делалась
# `docker exec -u root` по живому контейнеру — то есть умирала при первом пересоздании.
#
# `/bin/sh`, а не `bash`: оболочка busybox уже лежит в alpine, а `bash` — лишний пакет,
# которого мы в ландшафте не обещали (решение user 2026-08-13). Ландшафт растёт решением,
# а не по ходу дела: всё сверх базового — другая схема локации (`WORLD2` 2.4).
#
# Сторож при этом как бежал не из-под root, так и бежит: дом и оболочка — про человека,
# который входит, а не про права службы.
RUN addgroup -S world \
 && adduser -S -G world -h /home/world -s /bin/sh world \
 && mkdir -p /home/world /home/world/.npm-global /home/world/.secrets /place \
 && chown -R world:world /home/world \
 && chown world:world /place

COPY --from=core /out/world /app/world

# Что задаётся образом, а что — конфигом локации:
#
#   WORLD_ADDR   ЗДЕСЬ. Порт внутри контейнера фиксирован — на него смотрят EXPOSE и
#                HEALTHCHECK, и крутить его незачем: наружу локация не публикуется вовсе
#                (`kb:FUND-5` — наружу торчит ровно одна дверь, и это дверь мира);
#   WORLD_NAME   в конфиге (`deploy/location.env`): имя локации в поле = её маршрут за
#   WORLD_GIVES  дверью и её же имя в общей сети;
#   WORLD_DOOR   в конфиге, умолчание `door:8080` — контрактное имя двери в общей сети.
#
# Умолчания `WORLD_NAME`/`WORLD_GIVES` в образе НЕТ намеренно: локация без имени и без
# «что даёт» попала бы в поле безымянной, и взять её осмысленно было бы нельзя. Пусть
# лучше вход откажет словами, чем в поле появится «location-1» (`kb:WORLD-31`).
#
# `WORLD_BUILD_DIR` задан ЯВНО и здесь. Умолчание бинаря (`../build`) относительное и верно
# для запуска из каталога `core/`, а не внутри образа — оставь мы его, сторож поднялся бы
# вовсе без каталога стройки и отказывал бы `build-off` (`core/README.md`). Это тот самый
# СКЛАД ПОД ЗАСТРОЙКУ: в нём лежит сама постройка (`/place/build`) и её паспорт
# (`/place/build.json`), и на него смонтирован том — иначе постройка не пережила бы
# пересоздания контейнера (`kb:WORLD-28`: состояние живёт на томе, вне тома только времянки).
#
# `HOME` назван явно рядом с ними: докер берёт его из паспорта пользователя не во всех
# случаях, а редактор и оболочка на него смотрят. Пустой `HOME` — это ровно то падение,
# с которого началась `tasker:WORLD-106`.
#
# ИНСТРУМЕНТЫ В МЕСТО ПРИНОСИТ ЮЗЕР, и место обязано позволять их СТАВИТЬ, а не только
# смотреть (`WORLD2` 0.1: мир не изготовитель, руки — это юзер; 2.4: ландшафт задаёт, каким
# место рождается). Без префикса `npm i -g` уходит в `/usr/local/lib/node_modules`, который
# принадлежит root, и падает `EACCES` — то есть инструмент в место не поставить вовсе
# (живой упор 2026-08-13, `tasker:WORLD-108`). Префикс — в доме пользователя, его каталог —
# в `PATH` образа, значит виден и неинтерактивной оболочке (`docker exec … sh -c`).
#
# Поставленное этим способом — ВРЕМЯНКА (`WORLD2` 1.9): дом не на томе, и пересоздание
# контейнера уносит его. Это осознанно: инструмент ставится заново одной командой, а на
# томе живёт то, что построено (`/place`).
ENV WORLD_ADDR=":8080" \
    WORLD_BUILD_DIR="/place" \
    HOME="/home/world" \
    NPM_CONFIG_PREFIX="/home/world/.npm-global" \
    PATH="/home/world/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Оболочка-логин собирает `PATH` заново из `/etc/profile`, и `ENV` выше до неё не доезжает:
# терминал редактора запускается именно так. Без этой строки `npm i -g` проходил бы, а
# поставленное «не находилось» — отказ без причины на ровном месте.
RUN mkdir -p /etc/profile.d \
 && printf '%s\n' 'export PATH=/home/world/.npm-global/bin:$PATH' \
    > /etc/profile.d/npm-global.sh

USER world
# Рабочий каталог СЛУЖБЫ — там лежит её бинарь. Человек, вошедший в место, работает не
# здесь, а в `/place`: там склад под застройку и там же переживает пересоздание всё, что он
# построит. Сказано в `deploy/README.md`, раздел «Как войти в место», и в выводе подъёма —
# менять `WORKDIR` службы ради этого не станем: у процесса и у человека разные места.
WORKDIR /app
EXPOSE 8080

# Проба жизни — та же ручка, что у всей родни: `docker ps` обязан показывать не «поднят»,
# а «отвечает». Для локации это не украшение: присутствие в поле проверяется
# ДОСТИЖИМОСТЬЮ (`kb:WORLD-53`), и «контейнер запущен» тут не значит ничего.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

# Тот же бинарь, другой режим. `CMD`, а не зашитый аргумент в `ENTRYPOINT`: так вход в
# поле делается ТЕМ ЖЕ образом одной командой — `docker … run … join`, `… leave`, `… who`,
# и подъём локации не требует второго изделия (контракт `owner-core`, `tasker:WORLD-83`).
ENTRYPOINT ["/app/world"]
CMD ["guard"]

# Образ раздачи скоупа — вилка, которую мы выпускаем как удобство (`WORLD2` 0.3, 3.4).
#
# ┌─────────────────────────────────────────────────────────────────────────────────────┐
# │ В ЭТОМ ОБРАЗЕ НЕТ НИЧЕГО, КРОМЕ ОДНОГО БИНАРЯ. Ни шелла, ни пакетного менеджера, ни   │
# │ curl. И это не аскеза: раздача стоит на машине юзера и держит его личность — всё, что │
# │ лежит рядом с ней, лежит рядом с его ключами. Чего в образе нет, то и не захватят.    │
# │                                                                                      │
# │ Позволить себе это можно потому, что зависимостей у зоны нет вовсе: Go со стандартной │
# │ библиотекой, как у `core` и `control`. Даже стук в живость — команда самого бинаря    │
# │ (`share knock`), а не отдельный инструмент: иначе ради проверки пришлось бы тянуть в  │
# │ поставку bash или curl.                                                              │
# └─────────────────────────────────────────────────────────────────────────────────────┘
#
# Контекст сборки — САМА ЗОНА (`share/`), а не корень репозитория: в отличие от
# контроллера, раздача не зовёт ничего чужого и ничьих файлов в образ не берёт. Что из
# зоны попадает в контекст — в `share/Dockerfile.dockerignore` (белый список).
#
#   docker build -f share/Dockerfile -t ghcr.io/omnifield/world-share:latest share

# ── сборка бинаря ────────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS build
WORKDIR /src
# Зависимостей у зоны нет и не заводится — только стандартная библиотека. Поэтому ни
# `go mod download`, ни кэша модулей здесь нет: качать нечего, и сборка идёт без сети.
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/share ./cmd/share

# Каталог состояния заводится ЗДЕСЬ, в сборке, и с нужным хозяином. Причина: докер
# заводит новый том по образу того, что лежит в образе на этом пути, — вместе с правами и
# хозяином. Не завести его тут значит получить том, принадлежащий root, при процессе,
# который бежит не от root, и первую запись, отказавшую по правам на живой машине юзера.
RUN mkdir -p /state && chown 65532:65532 /state && chmod 700 /state

# ── образ ────────────────────────────────────────────────────────────────────
FROM scratch

COPY --from=build /out/share /share
COPY --from=build --chown=65532:65532 /state /state

# Не от root. Раздача не управляет машиной и ничего на ней не поднимает — ей нужен ровно
# один каталог и один порт. Номер, а не имя: в образе нет `/etc/passwd`, и имя было бы
# некому разрешить.
USER 65532:65532

ENV SHARE_ADDR=":8070" \
    SHARE_STATE="/state/scope.json"

# ПАРОЛЯ ЗДЕСЬ НЕТ И БЫТЬ НЕ МОЖЕТ. Он называется при подъёме (`SHARE_PASSWORD`) и
# принадлежит юзеру: пароль, уехавший в образ, стал бы общим на всех, кто этот образ
# тянет. Без него раздача не поднимается вовсе и говорит, чего не хватает.

EXPOSE 8070

# Том — не украшение: состояние обязано пережить и перезапуск, и смену образа. Вещь живёт,
# пока жив её том (`WORLD2` 1.9), а вещь здесь — личность юзера.
VOLUME ["/state"]

# Проба изнутри — чтобы `docker ps` показывал не «поднят», а «отвечает». Стучим СВОИМ
# бинарём: в образе больше ничего нет. Что именно проверяет стук и почему без пароля —
# в `cmd/share/knock.go`.
HEALTHCHECK --interval=10s --timeout=5s --start-period=3s --retries=3 \
    CMD ["/share", "knock"]

# Точка входа — сам бинарь. Точки входа-скрипта здесь нет намеренно: у контроллера она
# проверяет власть над машиной и раскладку (`control/control-entry.sh`), а раздаче
# проверять нечего — ей нужны каталог и порт, и оба она называет первой же строкой
# журнала. Скрипт означал бы шелл в образе, то есть ровно то, чего мы здесь не держим.
ENTRYPOINT ["/share"]

# justfile — единственная точка входа в репозиторий: что здесь вообще можно запустить.
#
# Заведён 2026-08-22 (решение user). До него команды жили по грамотам зон и по CI, и человек,
# открывший репозиторий, не знал, что запустить. Здесь они названы одним списком: `just` без
# аргументов печатает его целиком.
#
# ⚠️ Это НЕ система сборки. `just` не строит граф, не кеширует и не решает, что устарело, —
# он только зовёт команды. Монорепо-инструменты (Nx, Turborepo, Bazel, Moon) сознательно НЕ
# берём: они окупаются на графе зависимостей между пакетами и кеше сборок, а у нас восемь зон,
# каждая собирается своей командой за секунды. Сверено с рынком 2026-08-22.
#
# ⚠️ Часть команд требует ДОКЕРА, которого в девбоксе нет, и это его свойство, а не поломка:
# живое живёт в CI, он один на всех. Такие команды помечены в описании словом «докер».
#
# Описание рецепта — ОДНА строка прямо над ним: `just --list` печатает только её. Пояснения
# длиннее строки живут внутри рецепта комментарием, иначе список превращается в обрывки фраз.

# Список команд (то же самое печатает `just --list`).
default:
    @just --list --unsorted

# ─────────────────────────────────────────────────────────────── проверки

# Всё, что проверяется без докера: Go, синтаксис shell, панель.
check: go-test shell-syntax web-test

# Go-тесты по трём модулям.
go-test:
    # Модуль у зоны свой — гоняем из папки зоны, а не из корня.
    go -C core test ./... -count=1
    go -C control test ./... -count=1
    go -C share test ./... -count=1

# Синтаксис всех shell-скриптов репозитория.
shell-syntax:
    #!/usr/bin/env bash
    # Скрипт, который не разбирается, линтеру разбирать нечем — поэтому синтаксис идёт
    # первым и отдельно. `git ls-files`, а не `find`: проверяем то, что лежит в репозитории,
    # а не то, что насыпала сборка в рабочее дерево.
    set -euo pipefail
    rc=0
    while IFS= read -r f; do bash -n "$f" || rc=1; done < <(git ls-files '*.sh')
    exit $rc

# shellcheck по всем скриптам; нет линтера — скажет вслух, а не соврёт зелёным.
shell-lint:
    #!/usr/bin/env bash
    # Порог `info`: SC2086 (незакавыченное значение), ради которого линтер и взят, живёт
    # именно на этом уровне, и `warning` его бы не показал.
    set -euo pipefail
    command -v shellcheck >/dev/null || { echo "shellcheck не установлен — НЕ ПРОГНАНО (в CI он есть)"; exit 3; }
    git ls-files '*.sh' | xargs shellcheck --severity=info

# Панель: типы и тесты (браузерные сценарии — отдельно, `just web-e2e`).
web-test:
    cd web && pnpm install --frozen-lockfile && pnpm typecheck && pnpm test

# Панель в настоящем браузере против настоящего контроллера — докер.
web-e2e:
    cd web && pnpm e2e

# ─────────────────────────────────────────────────────────────── пробы зон

# Все пять проб зон подряд.
probe: probe-control probe-share probe-remote probe-branching probe-gate

# Проба контроллера — обе ветки.
probe-control:
    ./control/probe-control.sh --both

# Проба раздачи личности.
probe-share:
    ./share/probe-share.sh

# Проба удалённой машины.
probe-remote:
    ./deploy/probe-remote.sh

# Проба ветвлений отказа.
probe-branching:
    ./deploy/probe-branching.sh

# Проба шлюза.
probe-gate:
    ./gate/probe-gate.sh

# ─────────────────────────────────────────────────────────────── подъём

# Поднять мир на этой машине — докер.
up:
    ./deploy/up.sh

# Поднять контроллер, руки юзера — докер.
control-up:
    ./control/up.sh

# Поднять раздачу личности — докер.
share-up:
    ./share/up.sh

# ─────────────────────────────────────────────────────────────── выпуск

# Холостой ход выпуска: что и куда поедет.
release-dry:
    # Формулу тега сверяем ИМ, а не своей догадкой: `git log` однажды отдал merge-коммит,
    # которого в реестре нет.
    ./deploy/release.sh --dry-run

# Публикация образов — НЕОБРАТИМА, сначала `just release-dry`. Докер.
release:
    ./deploy/release.sh

# Собрать образы из дерева, не тяня выпущенные — докер.
build:
    ./deploy/build.sh

# ─────────────────────────────────────────────────────────────── харнесс

# Показать зоны продукта и их папки по `.claude/harness.yaml`.
zones:
    @node -e 'import("./.claude/hooks/harness-config.mjs").then(m=>{const c=m.loadConfig(process.cwd());console.log(`продукт: ${c.product}`);for(const [z,v] of Object.entries(c.zones))console.log(`  ${z.padEnd(9)} ${(v.paths||[]).join(", ")}`)})'
